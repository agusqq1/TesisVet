# Copiá este archivo como ".env" y completá los valores. El archivo .env no se sube a git.

# --- Base de datos MySQL (la usan la app y docker-compose.yml) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vetanimal
DB_USER=vetanimal
DB_PASSWORD=elegi-una-clave
DB_ROOT_PASSWORD=elegi-otra-clave

# --- App ---
# Puerto en el que escucha la app (por defecto 3000)
# PORT=3000

# Dirección pública de la app. En producción hay que definirla: se usa para armar
# el enlace de "olvidé mi contraseña" (ej. https://www.mi-veterinaria.com.ar)
# APP_URL=

# --- Supabase ---
# Se usa en el cliente de Vite. Copiar estos valores desde el panel de Supabase.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima

# --- Chat con IA (opcional) ---
# Clave de la API de Gemini: se obtiene gratis en https://aistudio.google.com/apikey
# Sin clave, el chat responde con una base de respuestas fijas.
# GEMINI_API_KEY=

# --- Envío de emails (opcional) ---
# Sin SMTP_PASS los emails no se envían (quedan anotados en la consola del servidor).
# Con Gmail: activar la verificación en dos pasos y crear una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords. Esa clave de 16 letras va en SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=veterinariavet101@gmail.com
SMTP_PASS=
SMTP_FROM="VetAnimal Clínica Veterinaria <veterinariavet101@gmail.com>"

# --- Notificaciones push: generar con `npx web-push generate-vapid-keys` ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
# Secreto para el cron de recordatorios (cualquier texto largo al azar)
CRON_SECRET=
